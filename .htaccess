<IfModule mod_rewrite.c>
    RewriteEngine On

    # Only redirect an explicit request; keep Apache's internal DirectoryIndex working.
    RewriteCond %{HTTP_HOST} ^(?:www\.)?tuinwerkenmylemans\.be$ [NC]
    RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
    RewriteRule ^index\.html$ https://tuinwerkenmylemans.be/ [R=301,L]

    RewriteCond %{HTTP_HOST} ^www\.tuinwerkenmylemans\.be$ [NC]
    RewriteRule ^ https://tuinwerkenmylemans.be%{REQUEST_URI} [L,R=301]

    RewriteCond %{HTTP_HOST} ^tuinwerkenmylemans\.be$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
    RewriteRule ^ https://tuinwerkenmylemans.be%{REQUEST_URI} [R=301,L]

    # Development notes and working files are not public website content.
    RewriteRule ^(?:\.git|\.idea|tmp|docs|scripts|nieuwefotos)(?:/|$) - [F,L,NC]
</IfModule>

<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType image/avif .avif
    AddType font/woff2 .woff2
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/avif "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/ld+json application/xml text/xml image/svg+xml
</IfModule>

<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com data:; img-src 'self' data: https:; connect-src 'self' https://formspree.io; frame-src https://www.google.com; form-action https://formspree.io; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; upgrade-insecure-requests"
</IfModule>
